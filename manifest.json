{
  "manifest_version": 3,
  "name": "文章透镜",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "description": "用 Jev 分析文章的论证、证据和推理。支持网页读取和正文粘贴。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.typesafe.ai/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "读取当前文章 · 打开文章透镜",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.typesafe.ai; base-uri 'none'; frame-src 'none'"
  }
}
